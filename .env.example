# Safe examples only. No credentials are needed for the default startup.
LEANEDGE_TRADING_MODE=paper
LEANEDGE_LOG_LEVEL=INFO
LEANEDGE_PAPER_STARTING_BALANCE=1000.00

# Optional Telegram mode only. Add your token privately in .env, never here.
LEANEDGE_TELEGRAM_BOT_TOKEN=
LEANEDGE_TELEGRAM_USER_ID=

# Independent, optional READ-ONLY providers. Never add wallet keys.
LEANEDGE_HELIUS_API_KEY=
LEANEDGE_JUPITER_API_KEY=
# AI also requires ai.enabled=true and current, verified pricing in TOML.
LEANEDGE_DEEPSEEK_API_KEY=
